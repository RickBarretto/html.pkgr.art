import.version: 3.1.1 {unitt}!
import {src/html}!
it "renders a document" [
    expects -> (fragment [\html [\body [\p "Hello"]]]) = "<!DOCTYPE html><html><body><p>Hello</p></body></html>"
]
it "renders root attributes and captures the document once" [
    document: fragment [\html.lang: "en" [\head [\title "<&>"] \body []]]
    expects -> document = {<!DOCTYPE html><html lang="en"><head><title>&lt;&amp;&gt;</title></head><body></body></html>}
    reusable: html\element "span" "Hello"
    expects -> (fragment reusable) = "<span>Hello</span>"
    expects -> (to :string reusable) = "<span>Hello</span>"
]
unless key? args 'filename -> unitt\report 'full
