; Markup is serialized eagerly: blocks run once and generated markup stays distinct from text.
define :htmlMarkup [
    init: method [value :string][this\value: new value]
    string: method [][this\value]
]
define :htmlRaw is :htmlMarkup []
define :htmlDocument is :htmlMarkup []
escapeHtml: function [value :string][
    value: replace value "&" "&amp;"
    value: replace value "<" "&lt;"
    value: replace value ">" "&gt;"
    replace value {"} "&quot;"
]
serializeHtml: function [value][
    if null? value [return ""]
    if is? :htmlMarkup value [return to :string value]
    ensure.that: "HTML children must be strings or markup" -> string? value
    escapeHtml value
]

define :html [

    init: method [][
        elements: [
            ; Main
            body head

            ; Web Components
            slot template

            ; Editing
            del ins

            ; Embedded Content
            embed iframe object picture source

            ; Forms
            button datalist fieldset form input label legend meter optgroup
            option output progress select textarea

            ; Inline Text 
            a abbr b bdi bdo br cite code data dfn em i kbd mark q s rp rt 
            ruby samp small span strong sub sup time u var wbr

            ; Interactives
            details dialog summary

            ; Metadata Content 
            base link meta title style

            ; Multimedia
            area audio img map track video

            ; Scripting
            canvas noscript script

            ; Content Sectioning
            address article aside footer header h1 h2 h3 h4 h5 h6 hgroup main 
            nav section search

            ; Tables
            caption col colgroup table tbody td tfoot th thead tr

            ; Text Content
            blockquote dd div dl dt figcaption figure hr li menu ol p pre ul
        ]
        
        loop elements 'el [
            body: [\element x]
            insert 'body 1 to :literal el
            this\[el]: method [x] body
        ]
    ]

    _process: method [content][
        @content
    ]

    kebab: method [content :string][
        replace content "_" "-"
    ]

    raw: method [value :string][to :htmlRaw @[value]]

    element: method.public [tag :string :literal content][
        tag: lower to :string tag
        ensure.that: "Invalid HTML tag name" -> match? tag {^[a-z][a-z0-9-]*$}
        normalized: #[]
        if dictionary? content [
            loop content [key value][normalized\[\kebab lower to :string key]: value]
        ]
        loop attrs [key value][normalized\[\kebab lower to :string key]: value]
        attributes: ""
        loop sort keys normalized 'key [
            ensure.that: "Invalid HTML attribute name" -> match? key {^[a-z_:][a-z0-9_.:-]*$}
            value: normalized\[key]
            unless null? value [
                ensure.that: "Unsupported attribute value" -> in? type value [:string :literal :integer :floating :logical]
                boolean: in? key ["disabled" "checked" "selected" "multiple" "required" "readonly" "autofocus" "hidden" "open" "controls" "autoplay" "loop" "muted" "novalidate" "formnovalidate" "reversed" "ismap" "defer" "async" "allowfullscreen" "inert" "itemscope" "nomodule" "playsinline" "default" "disablepictureinpicture" "disableremoteplayback" "shadowrootclonable" "shadowrootdelegatesfocus" "shadowrootserializable"]
                switch and? boolean logical? value [
                    if value [attributes: attributes ++ " " ++ key]
                ][
                    attributes: attributes ++ " " ++ key ++ {="} ++ (escapeHtml to :string value) ++ {"}
                ]
            ]
        ]
        children: []
        unless dictionary? content [
            children: (block? content)? [@content] [@[content]]
        ]
        children: select children 'child [not? null? child]
        void: in? tag ["area" "base" "br" "col" "embed" "hr" "img" "input" "link" "meta" "source" "track" "wbr"]
        if void [
            ensure.that: "Void elements cannot have children" -> or? empty? children children = [""]
            return to :htmlMarkup @[~"<|tag||attributes|>"]
        ]
        if in? tag ["script" "style"] [
            loop children 'child [ensure.that: "Use html raw for trusted script/style content" -> or? child = "" is? :htmlRaw child]
        ]
        rendered: join map children 'child [serializeHtml child]
        to :htmlMarkup @[~"<|tag||attributes|>|rendered|</|tag|>"]
    ]

    html: method [page :block][
        html4: attr 'html4
        ensure.that: "HTML4 mode is no longer supported" -> null? html4
        document: "<!DOCTYPE html>" ++ to :string \element 'html page
        to :htmlDocument @[document]
    ]

]

html: to :html []
fragment: $[content][
    values: (block? content)? [html\_process content] [@[content]]
    join map values 'value [serializeHtml value]
]!
