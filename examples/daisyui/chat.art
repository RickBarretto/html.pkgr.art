import {src/html}!

; daisyUI components plus Tailwind utilities; replies stay local to this page.
print fragment html.lang: "en".data_theme: "light" [
  head [
    meta.charset: "utf-8" #[]
    meta.name: "viewport"
      .content: "width=device-width, initial-scale=1" #[]

    title "Companion — daisyUI chat demo"

    link.rel: "stylesheet"
      .href: "https://cdn.jsdelivr.net/npm/daisyui@5.7.50/daisyui.css" #[]

    script.src: "https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4" []

    ; These classes also style messages appended by the local demo script.
    style [
      raw {
        .message { padding: 1.25rem; margin: 1rem 0; border-radius: 1rem; }
        .message h2 { font-weight: 700; font-size: .875rem; margin-bottom: .5rem; }
        .message p { white-space: pre-wrap; overflow-wrap: anywhere; }
        .user-message { margin-left: 10%; background: #e5eeea; }
        .assistant-message { margin-right: 5%; border: 1px solid #dce3df; }
      }
    ]
  ]

  body.class: "bg-base-100 text-base-content" [
    div.class: "grid min-h-dvh md:grid-cols-[16rem_1fr]" [
      aside.class: "bg-base-200 p-6" [
        p.class: "mb-5 text-xl font-bold" "Companion"

        button.id: "new-chat"
          .type: "button"
          .class: "btn btn-primary w-full" "New chat"

        nav.class: "mt-6".aria_label: "Conversation navigation" [
          ul.class: "menu w-full" [
            li [
              a.href: "#messages" "Current conversation"
            ]

            li [
              a.href: "#composer" "Write a message"
            ]
          ]
        ]
      ]

      main.class: "flex min-w-0 flex-col" [
        header.class: "navbar border-b border-base-300 px-6" [
          div [
            h1.class: "font-semibold" "Your everyday thinking partner"
            span.class: "badge badge-outline mt-1" "Local demo"
          ]
        ]

        div.class: "mx-auto w-full max-w-3xl flex-1 p-6" [
          section.id: "messages"
            .class: "max-h-[55dvh] overflow-y-auto p-2"
            .role: "log"
            .aria_live: "polite"
            .aria_label: "Conversation" [
              article.class: "message user-message" [
                h2 "You"
                p "How can I get started with Arturo?"
              ]

              article.class: "message assistant-message" [
                h2 "Assistant"

                p
                  "Start with a small script. Try printing a greeting, then turn it into a reusable function."
              ]
            ]

          form.id: "composer".class: "mt-8 grid gap-3" [
            label.for: "prompt".class: "font-medium" "Message Companion"

            textarea.id: "prompt"
              .name: "prompt"
              .class: "textarea textarea-bordered w-full"
              .rows: 3
              .required: true
              .placeholder: "Ask a question…" ""

            button.type: "submit"
              .class: "btn btn-primary justify-self-end" "Send message"
          ]

          p.class: "mt-3 text-sm opacity-70"
            "Replies are generated by a fixed local demo, not an AI model."

          noscript [
            p "Enable JavaScript to send messages in this demo."
          ]
        ]
      ]
    ]

    script [
      raw {
        const form = document.getElementById('composer');
        const prompt = document.getElementById('prompt');
        const messages = document.getElementById('messages');
        const initialMessages = messages.innerHTML;
        function addMessage(role, text) {
            const message = document.createElement('article');
            message.className = role === 'You' ? 'message user-message' : 'message assistant-message';
            const heading = document.createElement('h2');
            heading.textContent = role;
            const content = document.createElement('p');
            content.textContent = text;
            message.append(heading, content);
            messages.append(message);
            message.scrollIntoView({ block: 'nearest' });
        }
        form.addEventListener('submit', (event) => {
            event.preventDefault();
            const text = prompt.value.trim();
            if (!text) return;
            addMessage('You', text);
            addMessage('Assistant', 'Demo reply: you asked “' + text + '”. Break the task into one small step, try it, and review the result.');
            form.reset();
            prompt.focus();
        });
        document.getElementById('new-chat').addEventListener('click', () => {
            messages.innerHTML = initialMessages;
            form.reset();
            prompt.focus();
        });
      }
    ]
  ]
]
