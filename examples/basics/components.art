import {src/html}!

; Fragments return typed markup so components compose without escaping HTML.
card: function [name][
  fragment [
    article.class: "card" [
      h2 name

      p [
        "Hello, "
        strong name
        "!"
      ]
    ]
  ]
]

print fragment [
  section [
    loop ["Ana" "João"] 'person [
      card person
    ]

    if true [
      p "Registration is open"
    ]

    if false [
      p "Registration is closed"
    ]
  ]
]
