import {src/html}!

feature: function [heading description][
    markup\article.class: "rounded-2xl border border-slate-200 bg-white p-6" [
        h3.class: "text-xl font-semibold text-slate-900" heading
        p.class: "mt-3 text-slate-600" description
    ]
]

print fragment html.lang: "en" [
    head [
        meta.charset: "utf-8" #[]
        meta.name: "viewport".content: "width=device-width, initial-scale=1" #[]
        title "Gather — Tailwind landing page"
        ; Tailwind's browser CDN keeps this example build-free.
        script.src: "https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4" []
    ]
    body.class: "bg-slate-50 font-sans text-slate-800" [
        header.class: "mx-auto max-w-6xl px-6 py-6" [
            nav.class: "flex flex-wrap items-center justify-between gap-4".aria_label: "Main navigation" [
                a.class: "text-2xl font-bold tracking-tight".href: "#" "Gather"
                a.class: "hover:underline".href: "#features" "Features"
                a.class: "rounded-full bg-emerald-800 px-5 py-2 text-white".href: "#start" "Get started"
            ]
        ]
        main.class: "mx-auto max-w-6xl px-6" [
            section.class: "max-w-3xl py-20 sm:py-28" [
                p.class: "text-sm font-semibold tracking-widest text-emerald-800" "A CALMER WAY TO COLLABORATE"
                h1.class: "mt-6 text-5xl font-bold tracking-tight sm:text-7xl" "Good work starts with a little space."
                p.class: "mt-6 text-xl leading-relaxed text-slate-600" "Keep your notes, plans, and people together. Spend less time looking and more time making."
                a.class: "mt-8 inline-block rounded-full bg-emerald-800 px-7 py-3 font-semibold text-white hover:bg-emerald-900".href: "#start" "Find your focus"
            ]
            section.id: "features".class: "pb-20" [
                h2.class: "mb-8 text-3xl font-bold" "Everything you need to move forward"
                div.class: "grid gap-6 md:grid-cols-3" [
                    feature "One home for your ideas" "Bring scattered notes into a shared workspace."
                    feature "Plans that stay clear" "Give every project a next step and an owner."
                    feature "Room for everyone" "Share progress without another status meeting."
                ]
            ]
            section.id: "start".class: "rounded-3xl bg-emerald-950 p-10 text-white" [
                h2.class: "text-3xl font-bold" "Start something good"
                p.class: "my-4" "Tell us about your team."
                a.class: "inline-block rounded-full bg-white px-6 py-3 font-semibold text-emerald-950".href: "mailto:hello@example.com" "Talk to us"
            ]
        ]
        footer.class: "mx-auto max-w-6xl px-6 py-10 text-slate-500" [small "Gather · Thoughtfully simple."]
    ]
]
